# LastMinBuddy environment configuration
#
# The Gemini API key is used ONLY on the server (the Vite dev middleware in
# development, and the /api/gemini serverless function in production).
# It is never exposed to the browser. Do NOT prefix it with VITE_.
#
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
